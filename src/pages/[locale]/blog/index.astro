---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locales, isLocale, t, localePath, type Locale } from '../../../i18n/utils';
import { BLOG_POSTS } from '../../../data/blog-data';
import { getBlogPostContent } from '../../../data/blog-content';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) return Astro.redirect('/es/blog/');
const locale = localeParam as Locale;

const title = `${t(locale, 'blog.title')} — Ankabasi`;
const description = t(locale, 'blog.subtitle');
---

<BaseLayout locale={locale} title={title} description={description} pathAfterLocale="blog/">
	<section class="page page--mundo blog-page">
		<div class="container">
			<header class="page__header" data-aos="fade-up">
				<p class="page__eyebrow">{t(locale, 'nav.mundoAnkabasi')}</p>
				<h1 class="section__title">{t(locale, 'blog.title')}</h1>
				<div class="section__underline"></div>
				<p class="page__lead">{t(locale, 'blog.subtitle')}</p>
			</header>
			<div class="blog-list">
				{
					BLOG_POSTS.map((post, index) => {
						const content = getBlogPostContent(post.slug, locale);
						if (!content) return null;
						return (
							<article class="blog-card" data-aos="fade-up" data-aos-delay={Math.min(80 + index * 80, 240)}>
								<a href={localePath(locale, `blog/${post.slug}/`)} class="blog-card__link">
									<img
										src={post.featuredImage}
										alt={content.featuredAlt || content.title}
										class="blog-card__image"
										loading="lazy"
										width="640"
										height="400"
									/>
									<div class="blog-card__body">
										<time datetime={post.date}>{post.date}</time>
										<p class="blog-card__cat">{t(locale, `blog.cat_${post.category}`)}</p>
										<h2 class="blog-card__title">{content.title}</h2>
										<p class="blog-card__excerpt">{content.excerpt}</p>
										<span class="blog-card__more">{t(locale, 'blog.readMore')}</span>
									</div>
								</a>
							</article>
						);
					})
				}
			</div>
		</div>
	</section>
</BaseLayout>
