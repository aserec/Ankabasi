---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeSections from '../../components/HomeSections.astro';
import { locales, isLocale, t, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) {
	return Astro.redirect('/es/');
}
const locale = localeParam as Locale;

const title = t(locale, 'meta.title');
const description = t(locale, 'meta.description');
---

<BaseLayout locale={locale} title={title} description={description}>
	<HomeSections locale={locale} />
</BaseLayout>
