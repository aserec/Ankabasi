---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	locales,
	isLocale,
	t,
	localePath,
	type Locale,
} from '../../i18n/utils';
import { guideSlugs, guideKeyFromSlug, type GuideKey } from '../../i18n/routes';
import { getGuide } from '../../data/guides';
import { SITE } from '../../data/site';

export function getStaticPaths() {
	const paths: { params: { locale: string; guide: string } }[] = [];
	for (const locale of locales) {
		for (const key of Object.keys(guideSlugs) as GuideKey[]) {
			if (key === 'faq') continue;
			paths.push({ params: { locale, guide: guideSlugs[key][locale] } });
		}
	}
	return paths;
}

const { locale: localeParam, guide: guideSlug } = Astro.params;
if (!localeParam || !isLocale(localeParam) || !guideSlug) {
	return Astro.redirect('/es/');
}
const locale = localeParam as Locale;
const key = guideKeyFromSlug(guideSlug);
if (!key || key === 'faq') return Astro.redirect(`/${locale}/`);

const guide = getGuide(key);
const title = guide.title[locale];
const description = guide.description[locale];
const home = localePath(locale);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: { '@type': 'Organization', name: SITE.name },
	publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
	mainEntityOfPage: new URL(`/${locale}/${guideSlug}/`, Astro.site).href,
	inLanguage: locale,
};

const crumbs = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Ankabasi',
			item: new URL(home, Astro.site).href,
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: title,
			item: new URL(`/${locale}/${guideSlug}/`, Astro.site).href,
		},
	],
};
---

<BaseLayout
	locale={locale}
	title={`${title} — Ankabasi`}
	description={description}
	pathAfterLocale={`${guideSlug}/`}
	jsonLd={[jsonLd, crumbs]}
>
	<article class="guide container" style="padding: 6rem 1.25rem 4rem; max-width: 720px;">
		<nav aria-label="Breadcrumb" style="margin-bottom: 1.5rem; font-size: 0.9rem;">
			<a href={home}>Ankabasi</a>
			<span aria-hidden="true"> / </span>
			<span>{title}</span>
		</nav>
		<h1 style="font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 1rem;">{title}</h1>
		<p class="guide__lead" style="font-size: 1.1rem; line-height: 1.65; margin-bottom: 1.75rem;">
			{guide.lead[locale]}
		</p>
		{
			guide.body[locale].map((p) => (
				<p style="line-height: 1.7; margin-bottom: 1rem; color: #4a4a4a;">{p}</p>
			))
		}
		<p style="margin-top: 2.5rem; display: flex; flex-wrap: wrap; gap: 0.75rem;">
			<a class="btn btn--primary" href={home + '#contacto'}>{t(locale, 'nav.reservar')}</a>
			<a class="btn btn--secondary" href={localePath(locale, 'faq/')}>FAQ</a>
		</p>
	</article>
</BaseLayout>
