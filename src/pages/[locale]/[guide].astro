---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	locales,
	isLocale,
	t,
	localePath,
	type Locale,
} from '../../i18n/utils';
import { guideSlugs, guideKeyFromSlug, pagePath, type GuideKey } from '../../i18n/routes';
import { getGuide } from '../../data/guides';
import { SITE } from '../../data/site';

export function getStaticPaths() {
	const paths: { params: { locale: string; guide: string } }[] = [];
	for (const locale of locales) {
		for (const key of Object.keys(guideSlugs) as GuideKey[]) {
			if (key === 'faq') continue;
			paths.push({ params: { locale, guide: guideSlugs[key][locale] } });
		}
	}
	return paths;
}

const { locale: localeParam, guide: guideSlug } = Astro.params;
if (!localeParam || !isLocale(localeParam) || !guideSlug) {
	return Astro.redirect('/es/');
}
const locale = localeParam as Locale;
const key = guideKeyFromSlug(guideSlug);
if (!key || key === 'faq') return Astro.redirect(`/${locale}/`);

const guide = getGuide(key);
const title = guide.title[locale];
const description = guide.description[locale];
const home = localePath(locale);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	author: { '@type': 'Organization', name: SITE.name },
	publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
	mainEntityOfPage: new URL(`/${locale}/${guideSlug}/`, Astro.site).href,
	inLanguage: locale,
};

const crumbs = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Ankabasi',
			item: new URL(home, Astro.site).href,
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: title,
			item: new URL(`/${locale}/${guideSlug}/`, Astro.site).href,
		},
	],
};
---

<BaseLayout
	locale={locale}
	title={`${title} — Ankabasi`}
	description={description}
	pathAfterLocale={`${guideSlug}/`}
	jsonLd={[jsonLd, crumbs]}
>
	<article class="page page--mundo guide">
		<div class="container">
			<nav class="guide__nav" aria-label="Breadcrumb" data-aos="fade-up">
				<a href={home}>Ankabasi</a>
				<span aria-hidden="true"> / </span>
				<span>{title}</span>
			</nav>
			<header class="page__header page__header--bare" data-aos="fade-up">
				<p class="page__eyebrow">{t(locale, 'nav.mundoAnkabasi')}</p>
				<h1 class="section__title">{title}</h1>
				<div class="section__underline"></div>
				<p class="page__lead">{guide.lead[locale]}</p>
			</header>
			<div class="guide__body" data-aos="fade-up">
				{
					guide.body[locale].map((p) => (
						<p>{p}</p>
					))
				}
			</div>
			<p class="page__actions" data-aos="fade-up">
				<a class="btn btn--primary" href={pagePath(locale, 'contacto')}>{t(locale, 'nav.reservar')}</a>
				<a class="btn btn--secondary" href={localePath(locale, 'faq/')}>FAQ</a>
			</p>
		</div>
	</article>
</BaseLayout>
