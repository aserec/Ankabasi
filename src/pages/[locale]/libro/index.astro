---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SplitMedia from '../../../components/SplitMedia.astro';
import { locales, isLocale, t, localePath, type Locale } from '../../../i18n/utils';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) return Astro.redirect('/es/libro/');
const locale = localeParam as Locale;
const home = localePath(locale);
---

<BaseLayout
	locale={locale}
	title={`${t(locale, 'libro.title')} — Ankabasi`}
	description={t(locale, 'libro.subtitle')}
	pathAfterLocale="libro/"
>
	<section class="page page--mundo libro-page">
		<div class="container">
			<header class="page__header page__header--bare" data-aos="fade-up">
				<p class="page__eyebrow">{t(locale, 'nav.mundoAnkabasi')}</p>
				<h1 class="section__title">{t(locale, 'libro.bookTitle')}</h1>
				<div class="section__underline"></div>
				<p class="page__lead">{t(locale, 'libro.subtitle')}</p>
			</header>
			<SplitMedia
				image="/images/blog/DSC09240.jpg"
				alt="Tejido y memoria en el territorio"
				objectPosition="center 40%"
				aos="fade-up"
			>
				<p class="split__text">{t(locale, 'libro.excerpt')}</p>
				<p><strong>{t(locale, 'libro.status')}</strong></p>
				<p class="page__actions">
					<a class="btn btn--primary" href="/libro/">{t(locale, 'libro.startReading')}</a>
					<a class="btn btn--secondary" href={home}>{t(locale, 'libro.backHome')}</a>
				</p>
			</SplitMedia>
		</div>
	</section>
</BaseLayout>
