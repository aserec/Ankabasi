---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, isLocale, t, type Locale } from '../../i18n/utils';
import { faqItems, faqJsonLd } from '../../data/faq';
import { pagePath } from '../../i18n/routes';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) return Astro.redirect('/es/faq/');
const locale = localeParam as Locale;

const title = `FAQ — Ankabasi`;
const description = t(locale, 'faq.subtitle');
---

<BaseLayout
	locale={locale}
	title={title}
	description={description}
	pathAfterLocale="faq/"
	jsonLd={faqJsonLd(locale)}
>
	<section class="page page--mundo faq-page" id="faq">
		<div class="container">
			<header class="page__header" data-aos="fade-up">
				<p class="page__eyebrow">{t(locale, 'nav.mundoAnkabasi')}</p>
				<h1 class="section__title">{t(locale, 'faq.title')}</h1>
				<div class="section__underline"></div>
				<p class="page__lead">{t(locale, 'faq.subtitle')}</p>
			</header>
			<div class="faq-list">
				{
					faqItems.map((item, index) => (
						<details class="faq-item" data-aos="fade-up" data-aos-delay={Math.min(80 + index * 40, 280)}>
							<summary>{item.question[locale]}</summary>
							<p>{item.answer[locale]}</p>
						</details>
					))
				}
			</div>
			<p class="page__actions" data-aos="fade-up">
				<a class="btn btn--primary" href={pagePath(locale, 'contacto')}>{t(locale, 'nav.reservar')}</a>
				<a class="btn btn--secondary" href={pagePath(locale, 'experiencias')}>{t(locale, 'pricing.title')}</a>
			</p>
		</div>
	</section>
</BaseLayout>
