---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, isLocale, t, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const { locale: localeParam } = Astro.params;
if (!localeParam || !isLocale(localeParam)) return Astro.redirect('/es/formacion/');
const locale = localeParam as Locale;

const courses = ['course1', 'course2', 'course3', 'course4'] as const;
const icons = ['fa-laptop', 'fa-seedling', 'fa-comments', 'fa-microchip'] as const;
---

<BaseLayout
	locale={locale}
	title={`${t(locale, 'cursos.title')} — Ankabasi`}
	description={t(locale, 'cursos.subtitle')}
	pathAfterLocale="formacion/"
>
	<section class="page community-section community-section--cursos" id="cursos">
		<div class="container">
			<header class="page__header" data-aos="fade-up">
				<h1 class="section__title">{t(locale, 'cursos.title')}</h1>
				<div class="section__underline"></div>
				<p class="section__subtitle">{t(locale, 'cursos.subtitle')}</p>
				<p class="community-section__intro">{t(locale, 'cursos.description')}</p>
			</header>
			<div class="cursos__grid">
				{
					courses.map((course, index) => (
						<article class="cursos__card" data-aos="fade-up" data-aos-delay={100 + index * 50}>
							<div class="cursos__icon" aria-hidden="true">
								<i class={`fa-solid ${icons[index]}`}></i>
							</div>
							<h2 class="cursos__title">{t(locale, `cursos.${course}.title`)}</h2>
							<p class="cursos__desc">{t(locale, `cursos.${course}.desc`)}</p>
						</article>
					))
				}
			</div>
			<p class="cursos__soon" data-aos="fade-up">{t(locale, 'cursos.comingSoon')}</p>
		</div>
	</section>
</BaseLayout>
