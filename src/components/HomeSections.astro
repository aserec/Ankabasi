                    <div class="activity__icon"><i class="fa-solid fa-person-hiking"></i></div>
                    <h3 class="activity__title">{t(locale, 'activities.walks_t')}</h3>
                    <p class="activity__description">{t(locale, 'activities.walks_d')}</p>
                </div>
                
                <div class="activity__card" data-aos="fade-up" data-aos-delay="200">
                    <div class="activity__icon"><i class="fa-solid fa-comments"></i></div>
