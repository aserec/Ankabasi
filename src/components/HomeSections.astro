            <div class="activities__grid">
                <div class="activity__card" data-aos="fade-up" data-aos-delay="100">
                    <div class="activity__icon"><i class="fa-solid fa-mountain"></i></div>
                    <h3 class="activity__title">{t(locale, 'activities.territory_t')}</h3>
                    <p class="activity__description">{t(locale, 'activities.territory_d')}</p>
                </div>
                
