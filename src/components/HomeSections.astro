                    <p class="activity__description">{t(locale, 'activities.education_d')}</p>
                </div>
                
                <div class="activity__card" data-aos="fade-up" data-aos-delay="400">
                    <div class="activity__icon"><i class="fa-solid fa-book-open"></i></div>
                    <h3 class="activity__title">{t(locale, 'activities.stories_t')}</h3>
                    <p class="activity__description">{t(locale, 'activities.stories_d')}</p>
                </div>
                
