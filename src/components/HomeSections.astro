                    <p class="activity__description">{t(locale, 'activities.food_d')}</p>
                </div>
                
                <div class="activity__card" data-aos="fade-up" data-aos-delay="300">
                    <div class="activity__icon"><i class="fa-solid fa-palette"></i></div>
                    <h3 class="activity__title">{t(locale, 'activities.craft_t')}</h3>
                    <p class="activity__description">{t(locale, 'activities.craft_d')}</p>
                </div>
                
                <div class="activity__card" data-aos="fade-up" data-aos-delay="350">
