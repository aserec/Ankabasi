---
import type { Locale } from '../i18n/utils';
import { t } from '../i18n/utils';
import { pagePath } from '../i18n/routes';
import SplitMedia from './SplitMedia.astro';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;

const pillars = [
	{
		key: 'tech',
		href: pagePath(locale, 'tecnologia'),
		image: '/images/gallery/foto12.jpeg',
		alt: 'Diálogo y herramientas de conocimiento en Gwimake',
	},
	{
		key: 'content',
		href: pagePath(locale, 'galeria'),
		image: '/images/gallery/foto1.jpeg',
		alt: 'Historias y contenido desde Gwimake',
	},
	{
		key: 'training',
		href: pagePath(locale, 'formacion'),
		image: '/images/gallery/foto6.jpeg',
		alt: 'Aprendizaje compartido en el territorio',
	},
	{
		key: 'exchange',
		href: pagePath(locale, 'experiencias'),
		image: '/images/gallery/foto8.jpeg',
		alt: 'Encuentro e intercambio cultural en Gwimake',
	},
	{
		key: 'venture',
		href: pagePath(locale, 'productos'),
		image: '/images/blog/DSC09347.jpg',
		alt: 'Mochilas y oficios del territorio',
	},
] as const;
---

<section class="main" id="inicio">
	<div class="main__overlay"></div>
	<div class="main__content container" data-aos="fade-up" data-aos-easing="ease-out-cubic">
		<h1 class="main__title">{t(locale, 'main.title')}</h1>
		<h2 class="main__subtitle">{t(locale, 'main.subtitle')}</h2>
		<p class="main__tagline">{t(locale, 'main.tagline')}</p>
		<div class="main__actions">
			<a href={pagePath(locale, 'experiencias')} class="btn btn--primary btn--large">
				{t(locale, 'nav.ctaExperiencias')}
			</a>
		</div>
	</div>
</section>

<section class="about" id="quienes-somos">
	<div class="container">
		<h2 class="section__title" data-aos="fade-up" data-aos-easing="ease-out-cubic">{t(locale, 'about.title')}</h2>
		<div class="section__underline" data-aos="fade-up" data-aos-easing="ease-out-cubic"></div>
		<SplitMedia
			image="/images/gallery/foto11.jpeg"
			alt="Camino y viviendas en Gwimake"
			objectPosition="center 30%"
			aos="fade-up"
		>
			<div class="about__text">
				<p>{t(locale, 'about.p1')}</p>
				<p>{t(locale, 'about.p2')}</p>
				<p>{t(locale, 'about.p3')}</p>
				<p class="about__closing">{t(locale, 'about.closing')}</p>
			</div>
		</SplitMedia>
	</div>
</section>

<section class="pillars" id="pilares">
	<div class="container">
		<h2 class="section__title" data-aos="fade-up" data-aos-easing="ease-out-cubic">{t(locale, 'pillars.title')}</h2>
		<div class="section__underline" data-aos="fade-up" data-aos-easing="ease-out-cubic"></div>
		<div class="split-stack">
			{
				pillars.map((item, index) => (
					<SplitMedia
						image={item.image}
						alt={item.alt}
						reverse={index % 2 === 1}
						href={item.href}
						aos="fade-up"
					>
						<h3 class="split__title">{t(locale, `pillars.${item.key}_t`)}</h3>
						<p class="split__text">{t(locale, `pillars.${item.key}_d`)}</p>
					</SplitMedia>
				))
			}
		</div>
	</div>
</section>
