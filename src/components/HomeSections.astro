    <!-- Mundo Ankabasi: Blog y Libro -->
    <section class="mundo-ankabasi" id="mundo-ankabasi">
        <div class="mundo-ankabasi__stripe" aria-hidden="true"></div>
        <div class="container">
            <header class="mundo-ankabasi__header" data-aos="fade-up">
                <p class="mundo-ankabasi__eyebrow">{t(locale, 'mundo.eyebrow')}</p>
                <h2 class="mundo-ankabasi__title">{t(locale, 'nav.mundoAnkabasi')}</h2>
                <div class="mundo-ankabasi__divider" aria-hidden="true"></div>
                <p class="mundo-ankabasi__subtitle">{t(locale, 'mundo.subtitle')}</p>
            </header>

            <div class="mundo-ankabasi__blocks">
                <section class="mundo-ankabasi__block blog" id="blog" data-aos="fade-up">
                    <h3 class="mundo-ankabasi__block-title">{t(locale, 'blog.title')}</h3>
                    <p class="mundo-ankabasi__block-subtitle">{t(locale, 'blog.subtitle')}</p>
                    <div class="blog-teaser__grid">
                        {
                            teaserPosts.map((post) => {
                                const content = getBlogPostContent(post.slug, locale);
                                if (!content) return null;
                                return (
                                    <article class="blog-card">
                                        <a href={localePath(locale, `blog/${post.slug}/`)} class="blog-card__link">
                                            <img
                                                src={post.featuredImage}
                                                alt={content.featuredAlt || content.title}
                                                class="blog-card__image"
                                                loading="lazy"
                                                width="480"
                                                height="300"
                                            />
                                            <div class="blog-card__body">
                                                <h4 class="blog-card__title">{content.title}</h4>
                                                <p class="blog-card__excerpt">{content.excerpt}</p>
                                                <span class="blog-card__more">{t(locale, 'blog.readMore')}</span>
                                            </div>
                                        </a>
                                    </article>
                                );
                            })
                        }
                    </div>
                    <p style="margin: 1rem 0 0;">
                        <a href={faqPath(locale)}>FAQ</a>
                        {' · '}
                        <a href={guidePath(locale, 'howToGetThere')}>{t(locale, 'nav.donde')}</a>
                        {' · '}
                        <a href={guidePath(locale, 'packages')}>{t(locale, 'pricing.title')}</a>
                    </p>
                    <div class="blog-teaser__actions">
                        <a href={blog} class="btn btn--primary btn--large">{t(locale, 'blog.allPosts')}</a>
                    </div>
                </section>

                <section class="mundo-ankabasi__block libro-teaser" id="libro" data-aos="fade-up" data-aos-delay="100">
                    <h3 class="mundo-ankabasi__block-title">{t(locale, 'libro.title')}</h3>
                    <p class="mundo-ankabasi__block-subtitle">{t(locale, 'libro.subtitle')}</p>
                    <div class="libro-teaser__content">
                        <h4 class="libro-teaser__book-title">{t(locale, 'libro.bookTitle')}</h4>
                        <p class="libro-teaser__excerpt">{t(locale, 'libro.excerpt')}</p>
                        <a href={libro} class="btn btn--secondary btn--large">{t(locale, 'libro.startReading')}</a>
                    </div>
                </section>
            </div>
        </div>
    </section>

    <!-- Footer -->
    
