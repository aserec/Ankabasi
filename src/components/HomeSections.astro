---
import type { Locale } from '../i18n/utils';
import { t, tHtml, localePath } from '../i18n/utils';
import { SITE } from '../data/site';
import { BLOG_POSTS } from '../data/blog-data';
import { getBlogPostContent } from '../data/blog-content';
import { faqPath, guidePath } from '../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const home = localePath(locale);
const blog = localePath(locale, 'blog/');
const libro = localePath(locale, 'libro/');
const waText = encodeURIComponent(t(locale, 'whatsapp.prefill'));
const waHref = `https://wa.me/${SITE.whatsappE164}?text=${waText}`;
const teaserPosts = BLOG_POSTS.slice(0, 2);
---

<section class="main" id="inicio">
        <div class="main__overlay"></div>
        <div class="main__content container" data-aos="fade-up">
            <h1 class="main__title">{t(locale, 'main.title')}</h1>
            <h2 class="main__subtitle">{t(locale, 'main.subtitle')}</h2>
            <p class="main__description">{t(locale, 'main.description')}</p>
            <div class="main__support" data-aos="fade-up" data-aos-delay="200">
                <p class="main__support-text" set:html={tHtml(locale, 'main.support')}></p>
            </div>
            <a href={home + "#contacto"} class="btn btn--primary btn--large">{t(locale, 'main.cta')}</a>
        </div>
    </section>

    <!-- Sección Experiencia Transformadora -->
    <section class="experience" id="experiencia">
        <div class="experience__overlay"></div>
        <div class="container">
            <div class="experience__content" data-aos="fade-up">
                <h2 class="section__title">{t(locale, 'experience.title')}</h2>
                <div class="section__underline"></div>
                <div class="experience__text">
                    <p set:html={tHtml(locale, 'experience.p1')}></p>
                    <p set:html={tHtml(locale, 'experience.p2')}></p>
                </div>
                <a href={home + "#actividades"} class="btn btn--secondary">{t(locale, 'experience.cta')}</a>
            </div>
        </div>
    </section>

    <!-- Sección Actividades -->
    <section class="activities" id="actividades">
