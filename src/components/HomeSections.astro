                <p class="payment__note">{t(locale, 'pricing.paymentNote')}</p>
            </div>
            
            <div class="pricing__grid">
                <!-- Plan 1 Día -->
                <div class="pricing__card" data-aos="fade-up" data-aos-delay="100">
                    <div class="pricing__header">
                        <h3 class="pricing__title">{t(locale, 'pricing.plan1_t')}</h3>
                        <div class="pricing__price">
                            <span class="pricing__currency">{t(locale, 'pricing.from')}</span>
                            <span class="pricing__amount">$700.000</span>
                        </div>
                    </div>
                    <ul class="pricing__features">
                        <li>{t(locale, 'pricing.plan1_f1')}</li>
                        <li>{t(locale, 'pricing.plan1_f2')}</li>
                        <li>{t(locale, 'pricing.plan1_f3')}</li>
                        <li>{t(locale, 'pricing.plan1_f4')}</li>
                        <li>{t(locale, 'pricing.plan1_f5')}</li>
                        <li>{t(locale, 'pricing.plan1_f6')}</li>
                        <li>{t(locale, 'pricing.plan1_f7')}</li>
                    </ul>
                    <a href={home + "#contacto"} class="btn btn--primary btn--block">{t(locale, 'nav.reservar')}</a>
                </div>
                
                <!-- Plan 3 Días -->
                <div class="pricing__card pricing__card--featured" data-aos="fade-up" data-aos-delay="200">
                    <div class="pricing__badge">{t(locale, 'pricing.popular')}</div>
                    <div class="pricing__header">
                        <h3 class="pricing__title">{t(locale, 'pricing.plan2_t')}</h3>
                        <div class="pricing__price">
                            <span class="pricing__currency">{t(locale, 'pricing.from')}</span>
                            <span class="pricing__amount">$1.300.000</span>
                        </div>
                    </div>
                    <ul class="pricing__features">
                        <li>{t(locale, 'pricing.plan2_f0')}</li>
                        <li>{t(locale, 'pricing.plan2_f1')}</li>
                        <li>{t(locale, 'pricing.plan2_f2')}</li>
                        <li>{t(locale, 'pricing.plan2_f3')}</li>
                        <li>{t(locale, 'pricing.plan2_f4')}</li>
                    </ul>
                    <a href={home + "#contacto"} class="btn btn--primary btn--block">{t(locale, 'nav.reservar')}</a>
                </div>
                
                <!-- Plan 1 Semana -->
                <div class="pricing__card" data-aos="fade-up" data-aos-delay="300">
                    <div class="pricing__header">
                        <h3 class="pricing__title">{t(locale, 'pricing.plan3_t')}</h3>
                        <div class="pricing__price">
                            <span class="pricing__currency">{t(locale, 'pricing.price')}</span>
                            <span class="pricing__amount">{t(locale, 'pricing.ask')}</span>
                        </div>
                    </div>
                    <ul class="pricing__features">
                        <li>{t(locale, 'pricing.plan3_f1')}</li>
                        <li>{t(locale, 'pricing.plan3_f2')}</li>
                        <li>{t(locale, 'pricing.plan3_f3')}</li>
                        <li>{t(locale, 'pricing.plan3_f4')}</li>
                        <li>{t(locale, 'pricing.plan3_f5')}</li>
                    </ul>
                    <a href={home + "#contacto"} class="btn btn--secondary btn--block">{t(locale, 'pricing.consult')}</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Sección Folleto -->
    <section class="brochure" id="folleto">
        <div class="container">
            <h2 class="section__title" data-aos="fade-up">{t(locale, 'brochure.title')}</h2>
            <div class="section__underline" data-aos="fade-up"></div>
            <p class="section__subtitle" data-aos="fade-up">{t(locale, 'brochure.subtitle')}</p>
            
            <div class="brochure__content" data-aos="fade-up" data-aos-delay="100">
                <div class="brochure__preview">
                    <div class="brochure__icon">📄</div>
                    <h3 class="brochure__title">{t(locale, 'brochure.cardTitle')}</h3>
                    <p class="brochure__description">{t(locale, 'brochure.cardDesc')}</p>
                    <a href="/Ankabasi%20folleto.pdf" 
                       download 
                       class="btn btn--primary btn--large"
                      >{t(locale, 'brochure.download')}</a>
                </div>
            </div>
        </div>
    </section>

