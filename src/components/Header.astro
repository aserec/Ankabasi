---
import type { Locale } from '../i18n/utils';
import { t, localePath } from '../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';
import { pagePath, faqPath } from '../i18n/routes';

interface Props {
	locale: Locale;
	pathAfterLocale?: string;
}
const { locale, pathAfterLocale = '' } = Astro.props;
const home = localePath(locale);

const gwimakeLinks = [
	{ href: pagePath(locale, 'experiencias'), key: 'nav.intercambio' },
	{ href: pagePath(locale, 'territorio'), key: 'nav.territorio' },
	{ href: pagePath(locale, 'galeria'), key: 'nav.galeria' },
	{ href: pagePath(locale, 'tecnologia'), key: 'nav.tecnologia' },
	{ href: pagePath(locale, 'formacion'), key: 'nav.formacion' },
	{ href: pagePath(locale, 'productos'), key: 'nav.productos' },
	{ href: pagePath(locale, 'contacto'), key: 'nav.contacto' },
];

const mundoLinks = [
	{ href: localePath(locale, 'blog/'), key: 'nav.blog' },
	{ href: localePath(locale, 'libro/'), key: 'nav.libro' },
	{ href: faqPath(locale), key: 'nav.faq' },
];
---

<header class="header" id="header">
	<nav class="nav" aria-label="Primary">
		<div class="nav__logo">
			<a href={home}>
				<img
					src="/images/logo/ankabasi-icon-outline.png"
					alt="Ankabasi"
					class="logo-img"
					width="48"
					height="48"
				/>
			</a>
		</div>

		<div class="nav__menu" id="nav-menu">
			<ul class="nav__list">
				<li class="nav__item">
					<a href={home} class="nav__link">{t(locale, 'nav.inicio')}</a>
				</li>
				<li class="nav__item nav__item--dropdown">
					<details class="nav__dropdown">
						<summary class="nav__summary">
							<span>{t(locale, 'nav.gwimake')}</span>
							<i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
						</summary>
						<ul class="nav__dropdown-list">
							{
								gwimakeLinks.map((link) => (
									<li>
										<a href={link.href} class="nav__dropdown-link">
											{t(locale, link.key)}
										</a>
									</li>
								))
							}
						</ul>
					</details>
				</li>
				<li class="nav__item nav__item--dropdown">
					<details class="nav__dropdown nav__dropdown--mundo">
						<summary class="nav__summary">
							<span>{t(locale, 'nav.mundoAnkabasi')}</span>
							<i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
						</summary>
						<ul class="nav__dropdown-list nav__mundo-list">
							{
								mundoLinks.map((link) => (
									<li>
										<a href={link.href} class="nav__dropdown-link">
											{t(locale, link.key)}
										</a>
									</li>
								))
							}
						</ul>
					</details>
				</li>
			</ul>
		</div>

		<div class="nav__actions">
			<LangSwitcher locale={locale} pathAfterLocale={pathAfterLocale} />
			<button
				type="button"
				class="nav__toggle"
				id="nav-toggle"
				aria-expanded="false"
				aria-controls="nav-menu"
				aria-label="Menu"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</nav>
</header>
