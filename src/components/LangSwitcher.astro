---
import type { Locale } from '../i18n/utils';
import { locales, localePath } from '../i18n/utils';
import { localeNames } from '../i18n/routes';

interface Props {
	locale: Locale;
	/** Path after locale, e.g. '' | 'faq/' | 'blog/slug/' */
	pathAfterLocale?: string;
}
const { locale, pathAfterLocale = '' } = Astro.props;
const rest = pathAfterLocale.replace(/^\/+/, '');
---

<nav class="lang-switcher" aria-label="Language">
	<ul class="lang-switcher__list">
		{
			locales.map((code) => (
				<li>
					<a
						href={localePath(code, rest)}
						hreflang={code}
						lang={code}
						class:list={['lang-switcher__link', { 'is-active': code === locale }]}
						aria-current={code === locale ? 'page' : undefined}
					>
						{code.toUpperCase()}
						<span class="sr-only"> ({localeNames[code]})</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.lang-switcher__list {
		display: flex;
		gap: 0.35rem;
		list-style: none;
		margin: 0;
		padding: 0;
		align-items: center;
	}
	.lang-switcher__link {
		display: inline-block;
		padding: 0.25rem 0.45rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: inherit;
		text-decoration: none;
		border-bottom: 2px solid transparent;
		opacity: 0.7;
	}
	.lang-switcher__link:hover,
	.lang-switcher__link:focus-visible {
		opacity: 1;
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}
	.lang-switcher__link.is-active {
		opacity: 1;
		border-bottom-color: currentColor;
	}
</style>
