---
import type { Locale } from '../i18n/utils';
import { locales, localePath } from '../i18n/utils';
import { localeNames } from '../i18n/routes';

interface Props {
	locale: Locale;
	pathAfterLocale?: string;
}
const { locale, pathAfterLocale = '' } = Astro.props;
const rest = pathAfterLocale.replace(/^\/+/, '');

const flags: Record<Locale, string[]> = {
	es: ['#c60b1e', '#ffc400', '#c60b1e'],
	en: [],
	de: ['#000000', '#dd0000', '#ffce00'],
	fr: ['#0055a4', '#ffffff', '#ef4135'],
};
---

<details class="lang-switcher">
	<summary class="lang-switcher__trigger" aria-label={localeNames[locale]}>
		<span class="lang-switcher__globe" aria-hidden="true">
			<i class="fa-solid fa-earth-americas"></i>
		</span>
		{
			locale === 'en' ? (
				<span class="lang-flag lang-flag--en" aria-hidden="true"></span>
			) : (
				<span class="lang-flag" aria-hidden="true">
					{flags[locale].map((color) => (
						<span class="lang-flag__bar" style={`background:${color}`} />
					))}
				</span>
			)
		}
		<span class="lang-switcher__code">{locale.toUpperCase()}</span>
		<i class="fa-solid fa-chevron-down lang-switcher__caret" aria-hidden="true"></i>
	</summary>
	<ul class="lang-switcher__list">
		{
			locales.map((code) => (
				<li>
					<a
						href={localePath(code, rest)}
						hreflang={code}
						lang={code}
						class:list={['lang-switcher__link', { 'is-active': code === locale }]}
						aria-current={code === locale ? 'page' : undefined}
					>
						{code === 'en' ? (
							<span class="lang-flag lang-flag--en" aria-hidden="true"></span>
						) : (
							<span class="lang-flag" aria-hidden="true">
								{flags[code].map((color) => (
									<span class="lang-flag__bar" style={`background:${color}`} />
								))}
							</span>
						)}
						<span class="lang-switcher__name">{localeNames[code]}</span>
					</a>
				</li>
			))
		}
	</ul>
</details>
