# FTP credentials for publishing dist/ to the web host.
# Copy this file to `.env` and fill in real values.
# Never commit `.env`.

FTP_HOST=ftp.ankabasi.com
FTP_USER=danel@ankabasi.com
FTP_PASSWORD=

# Folder that should contain index.html after upload.
# Typical cPanel web root: /public_html
# If the FTP user already logs into the web root, use /
FTP_REMOTE_DIR=/ankabasi.com/public_html

# Optional
FTP_PORT=21
# false = plain FTP (default). true = explicit FTPS. implicit = implicit FTPS.
FTP_SECURE=false
# Set to false only if FTPS fails because of a self-signed certificate.
FTP_TLS_REJECT_UNAUTHORIZED=true
